# Copy to .env and fill in. NEVER commit .env
OPENAI_API_KEY=sk-...

# Base URL. Point at the provider now; in Week 4 change this ONE line to
# http://localhost:8000/v1 to route through the cost router. Nothing else changes.
OPENAI_BASE_URL=https://api.openai.com/v1

# Verify these exact strings against your provider's model list before the benchmark.
FRONTIER_MODEL=gpt-6.1-sol
ECONOMY_MODEL=gpt-6-luna

RETRIEVER=embedding   # embedding | keyword | auto
TOP_K=4

# Langfuse tracing (optional). Leave blank to run without it.
# Keys: Langfuse > Settings > API keys. Host: https://cloud.langfuse.com (EU)
# or https://us.cloud.langfuse.com (US). LANGFUSE_TRACING=off disables it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Spending limits (checked before every model call). SPEND_LIMITS=off disables them.
# GLOBAL_DAILY_BUDGET_USD=5.00     # whole app per day; also stops runaway scripts
# CLIENT_DAILY_BUDGET_USD=0.05     # per client (demo visitor / API key) per day
# SOFT_LIMIT_RATIO=0.8             # past this share of the budget: cheap model
# CLIENT_RPM=20                    # requests per minute per client
